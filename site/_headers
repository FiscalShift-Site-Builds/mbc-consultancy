# Cloudflare Pages response headers.
# https://developers.cloudflare.com/pages/configuration/headers/
#
# 'sha256-UHIWIp5/+Xa5v3CBSV5Pw819lHuzUni4bifNcca+vFg=' is filled in by build.py with the SHA-256 of each inline
# <script> in the layout, so the CSP can stay strict without 'unsafe-inline'
# and can never drift out of sync with the markup.
#
# 'unsafe-inline' IS allowed for styles: the pages carry inline style
# attributes for one-off spacing, inherited from the design prototypes. Inline
# styles cannot execute code, so this is a far smaller concession than the
# script equivalent — which stays locked to hashes.

/mbc-consultancy/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; form-action 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self' 'sha256-UHIWIp5/+Xa5v3CBSV5Pw819lHuzUni4bifNcca+vFg=' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self'; object-src 'none'; frame-ancestors 'none'

# Filenames are not fingerprinted, so fonts cache hard while code revalidates.
/mbc-consultancy/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/mbc-consultancy/assets/img/*
  Cache-Control: public, max-age=604800

/mbc-consultancy/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/mbc-consultancy/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate
