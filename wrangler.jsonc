// Cloudflare Workers deployment (Workers Builds runs `npx wrangler deploy`).
// See docs/DEPLOY.md §2.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker's name in the Cloudflare dashboard, or Workers
  // Builds refuses the deploy.
  "name": "mbc-consultancy",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-01",

  // The committed site/ is prefixed for the GitHub Pages sub-path, so build a
  // domain-root copy into dist/ instead. MBC_SITE_URL feeds the canonical,
  // Open Graph, JSON-LD and sitemap URLs; it must stay a bare origin with no
  // path, or build.py prefixes every link with that path.
  "build": {
    "command": "MBC_SITE_URL=https://mbconsultancy.co.zw MBC_OUT_DIR=dist python3 build.py --check"
  },

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "observability": { "enabled": true }
}
